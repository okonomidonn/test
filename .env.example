DATABASE_URL="postgresql://user:password@host:5432/dbname"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Instagram連携（Meta for Developers のアプリ設定から取得）
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# OAuthのリダイレクト先を固定したい場合に指定（例: https://example.vercel.app）
APP_URL=""

# 定期実行（/api/cron/tick）の認証用。ランダムな長い文字列
CRON_SECRET=""

# 動画アップロード先（Vercel Blob）。Vercel上ではストア接続時に自動設定されます
BLOB_READ_WRITE_TOKEN=""

# AI検索チェック（/ai）。計測に使うAIのAPIキー。片方だけでも動きます
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# 使うモデル（省略時: gpt-5.5 / gemini-3.8-flash）
OPENAI_MODEL=""
GEMINI_MODEL=""
# APIキーをプロキシ側で付与する環境では、環境変数にキーを置かずに使うAIを列挙する（例: openai,gemini）
GEO_ENGINES=""
# サービス全体で24時間に取得する回答数の上限（省略時: 300）。1回答あたり数十円かかります
GEO_DAILY_ANSWER_LIMIT=""

# 課金（Stripe）。3つとも設定すると有料プランの申し込みが有効になります
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripeで作った月額の価格のID（price_...）。スターター 4,980円／プロ 14,800円（税込）
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# 特定商取引法に基づく表記（/ai/legal）
LEGAL_SELLER_NAME=""
LEGAL_REPRESENTATIVE=""
LEGAL_ADDRESS=""
LEGAL_PHONE=""
LEGAL_EMAIL=""

DATABASE_URL="postgresql://user:password@host:5432/dbname"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Instagram連携（Meta for Developers のアプリ設定から取得）
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# OAuthのリダイレクト先を固定したい場合に指定（例: https://example.vercel.app）
APP_URL=""

# 定期実行（/api/cron/tick）の認証用。ランダムな長い文字列
CRON_SECRET=""

# 動画アップロード先（Vercel Blob）。Vercel上ではストア接続時に自動設定されます
BLOB_READ_WRITE_TOKEN=""
